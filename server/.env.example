# Server
NODE_ENV=development
PORT=3001

# MongoDB Atlas — replace user, password, and cluster host from Atlas UI
# Options: retryWrites=true&w=majority are typical for Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Optional MongoDB driver tuning
# MONGODB_MAX_POOL_SIZE=10
# MONGODB_MIN_POOL_SIZE=1
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
# MONGODB_SOCKET_TIMEOUT_MS=45000

# NVIDIA NIM / AI (existing)
# NIM_API_KEY=
# NVIDIA_NIM_API_KEY=
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Sentry (optional)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.05

# Google Gemini — POST /api/ai/summarize (study material summarizer)
# GEMINI_API_KEY=
# Optional aliases: GOOGLE_AI_API_KEY
# GEMINI_MODEL=gemini-1.5-flash
# GEMINI_SUMMARIZE_MAX_INPUT_CHARS=120000
